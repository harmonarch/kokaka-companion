# 复制本文件为 .env.production 并填入真实值（.env.production 已被 git 忽略）
# 部署时由 scripts/deploy-secrets.mjs 读取并同步到 Worker。
# 值为空的 key 会被跳过，因此可留空的项可以不填。

# 必填：JWT 签名与密码哈希密钥（生产环境请使用新的随机值）
JWT_SECRET=
PASSWORD_HASH_SECRET=

# LLM 与向量检索
DEEPSEEK_API_KEY=
EMBEDDING_API_KEY=

# 监控面板鉴权（需与 dashboard 侧保持一致）
MONITORING_API_KEY=

# 可选：Sentry / LangSmith
SENTRY_DSN=
LANGSMITH_API_KEY=
