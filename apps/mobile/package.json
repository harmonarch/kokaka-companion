{
  "name": "@ai-companion/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "BROWSER=open expo start --web",
    "build": "expo export --platform web --source-maps",
    "build:sentry": "expo export --platform web --source-maps && sentry-cli sourcemaps inject dist && sentry-cli sourcemaps upload dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test \".test-dist/**/*.test.js\""
  },
  "dependencies": {
    "@ai-companion/api-client": "workspace:*",
    "@ai-companion/core": "workspace:*",
    "@ai-companion/shared": "workspace:*",
    "@babel/runtime": "^7.26.0",
    "@expo/metro-runtime": "~4.0.1",
    "@sentry/react-native": "~6.10.0",
    "expo": "~52.0.25",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.8",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.4",
    "expo-router": "~4.0.16",
    "expo-secure-store": "~14.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@sentry/cli": "^3.6.0",
    "@types/react": "~18.3.12",
    "typescript": "^5.7.2"
  }
}
