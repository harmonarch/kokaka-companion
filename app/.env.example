# Leave these blank during Expo development to use the Metro host automatically.
# Set reachable HTTPS/WSS addresses before building for physical devices.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_WS_URL=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
EXPO_PUBLIC_SENTRY_RELEASE=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Build-only variables for Source Maps. Keep SENTRY_AUTH_TOKEN in CI secrets.
SENTRY_ORG=
SENTRY_PROJECT=kokaka-mobile
SENTRY_AUTH_TOKEN=
